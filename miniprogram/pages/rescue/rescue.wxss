.page-container { position: relative; width: 100%; height: 100%; overflow: hidden; }
.map-view { width: 100%; height: 100%; }
.location-pill {
  position: absolute;
  left: 14px;
  right: 78px;
  top: 12px;
  z-index: 6;
  padding: 8px 10px;
  border-radius: 8px;
  background: rgba(15, 23, 42, .78);
  color: #fff;
  font-size: 12px;
  backdrop-filter: blur(12px);
}
.locate-btn {
  position: absolute;
  top: 12px;
  right: 14px;
  z-index: 7;
  width: 52px;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background: var(--c-accent);
  color: #fff;
  font-size: 12px;
  font-weight: 700;
}

/* Loading */
.loading-screen {
  position: absolute; inset: 0;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  background: var(--c-bg); z-index: 10;
}
.loading-spinner {
  width: 36px; height: 36px;
  border: 3px solid #e2e8f0; border-top-color: var(--c-danger);
  border-radius: 50%; animation: spin .8s linear infinite;
  margin-bottom: 12px;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 14px; color: var(--c-text-tertiary); }

/* Filter bar */
.filter-bar {
  position: absolute; top: 56px; left: 16px; right: 16px;
  white-space: nowrap; z-index: 5; padding-bottom: 4px;
}
.filter-chip {
  display: inline-block; padding: 7px 16px; margin-right: 8px;
  background: var(--c-glass); backdrop-filter: blur(12px);
  border: 1px solid var(--c-glass-border);
  border-radius: 100px; font-size: 12px; font-weight: 500;
  color: var(--c-text-secondary); box-shadow: var(--shadow-sm);
}
.filter-chip.active { background: var(--c-primary); color: #fff; border-color: var(--c-primary); }

/* Bottom panel */
.bottom-panel {
  position: absolute; bottom: 0; left: 12px; right: 12px;
  z-index: 5; margin-bottom: 8px;
  max-height: 50%;
}
.panel-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 14px 18px; cursor: pointer;
}
.panel-header-left { display: flex; align-items: center; gap: 10px; }
.panel-badge {
  background: var(--c-danger); color: #fff;
  font-size: 12px; font-weight: 700;
  width: 24px; height: 24px; line-height: 24px;
  text-align: center; border-radius: 50%;
}
.panel-title { font-size: 15px; font-weight: 600; color: var(--c-text-primary); }
.panel-arrow { font-size: 12px; color: var(--c-text-tertiary); }

/* Signal list */
.signal-list {
  max-height: 40vh; overflow-y: auto;
  padding: 0 4px 8px;
}
.list-empty {
  display: flex; flex-direction: column;
  align-items: center; padding: 24px 0;
}
.list-empty-icon { font-size: 36px; margin-bottom: 8px; }
.list-empty-text { font-size: 13px; color: var(--c-text-tertiary); }

/* Signal card */
.signal-card {
  display: flex; position: relative; overflow: hidden;
  margin: 0 14px 10px; padding: 12px;
  background: rgba(255,255,255,0.6);
  border-radius: var(--r-md); box-shadow: var(--shadow-sm);
  transition: transform 0.15s;
}
.signal-card:active { transform: scale(0.98); }
.signal-card.urgent {
  background: linear-gradient(135deg, rgba(254,242,242,0.9), rgba(255,255,255,0.9));
  border-left: 3px solid var(--c-danger);
}

.card-photo, .card-photo-placeholder {
  width: 72px; height: 72px; border-radius: var(--r-sm);
  margin-right: 12px; flex-shrink: 0;
}
.card-photo-placeholder {
  background: #f1f5f9; display: flex;
  align-items: center; justify-content: center;
  font-size: 13px;
  color: var(--c-text-tertiary);
}
.card-info { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: space-between; }
.card-tags { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 4px; }
.need-chip {
  background: rgba(37,99,235,0.08); color: var(--c-accent);
  font-size: 11px; font-weight: 500;
  padding: 2px 8px; border-radius: 100px;
}
.card-desc {
  font-size: 13px; color: var(--c-text-secondary); line-height: 1.4;
  display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;
  margin-bottom: 4px;
}
.card-bottom { display: flex; justify-content: space-between; align-items: center; }
.card-distance { display: flex; align-items: center; gap: 3px; }
.dist-icon { font-size: 12px; }
.dist-value { font-size: 13px; font-weight: 700; color: var(--c-danger); }
.card-time { font-size: 11px; color: var(--c-text-tertiary); }
.detail-entry {
  align-self: flex-start;
  margin-top: 8px;
  padding: 5px 10px;
  border-radius: 8px;
  background: rgba(37,99,235,0.1);
  color: var(--c-accent);
  font-size: 12px;
  font-weight: 700;
}
.card-sos-ring {
  position: absolute; right: 12px; top: 12px;
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--c-danger); animation: sos-pulse 2s infinite;
}

/* SOS FAB */
.sos-fab {
  position: fixed; right: 20px;
  bottom: calc(120px + env(safe-area-inset-bottom));
  width: 60px; height: 60px; border-radius: 50%;
  background: linear-gradient(135deg, #dc2626, #b91c1c);
  color: #fff; z-index: 20;
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--shadow-glow-danger);
  cursor: pointer;
}
.sos-fab:active { transform: scale(0.92); }
.sos-fab-icon { font-size: 18px; font-weight: 800; letter-spacing: 1px; }
