.page-container { padding: 16px; padding-bottom: calc(40px + env(safe-area-inset-bottom)); background: var(--c-bg); min-height: 100%; box-sizing: border-box; }
.form-section { margin-bottom: 20px; background: #fff; border-radius: 12px; padding: 16px; }
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
.section-title { font-size: 15px; font-weight: 600; color: #333; }
.section-desc { font-size: 12px; color: #999; }

/* 位置 */
.location-card {
  display: flex; align-items: center; padding: 12px; background: #f8f8f8; border-radius: 8px;
}
.location-text { flex: 1; font-size: 14px; color: #333; }
.location-text.placeholder { color: #bbb; }
.location-arrow { font-size: 18px; color: #bbb; }

/* 照片 */
.photo-grid { display: flex; flex-wrap: wrap; gap: 8px; }
.photo-item { position: relative; width: 80px; height: 80px; border-radius: 8px; overflow: hidden; }
.photo { width: 100%; height: 100%; }
.photo-remove {
  position: absolute; top: -4px; right: -4px;
  width: 20px; height: 20px; border-radius: 50%;
  background: rgba(0,0,0,.5); color: #fff;
  font-size: 12px; text-align: center; line-height: 20px;
}
.photo-add {
  width: 80px; height: 80px; border: 2px dashed #ddd; border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
}
.add-icon { font-size: 28px; color: #bbb; }

/* 需求 */
.need-grid { display: flex; flex-wrap: wrap; gap: 8px; }
.need-item {
  padding: 8px 16px; border: 1px solid #e0e0e0; border-radius: 20px;
  font-size: 13px; color: #666;
}
.need-item.active { border-color: var(--c-accent); background: rgba(37,99,235,0.08); color: var(--c-accent); }

/* 描述 */
.desc-textarea {
  width: 100%; min-height: 80px; padding: 12px;
  background: #f8f8f8; border-radius: 8px; font-size: 14px; color: #333;
  box-sizing: border-box;
}

/* 电话 */
.phone-input {
  width: 100%; height: 44px; padding: 0 12px;
  background: #f8f8f8; border-radius: 8px; font-size: 14px; color: #333;
  box-sizing: border-box;
}

/* 提交 */
.submit-section { margin-top: 24px; }
.submit-btn {
  width: 100%; height: 48px; line-height: 48px;
  background: #ee0a24; color: #fff; font-size: 17px; font-weight: 600;
  border-radius: 12px; text-align: center; border: none;
}
.submit-btn[disabled] { background: #f0a0a8; color: rgba(255,255,255,.7); }
.submit-tip { display: block; text-align: center; font-size: 12px; color: #999; margin-top: 8px; }
