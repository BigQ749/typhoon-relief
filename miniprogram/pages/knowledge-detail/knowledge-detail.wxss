.page-container {
  height: 100%;
  background: #edf2f7;
}

.detail-hero {
  margin: 14px;
  padding: 18px;
  background: #fff;
  border-top: 5px solid #2563eb;
  border-radius: 8px;
  box-shadow: 0 4px 14px rgba(15,23,42,.08);
}

.detail-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12px;
}

.detail-tag,
.detail-level {
  font-size: 12px;
  font-weight: 800;
  color: #64748b;
}

.detail-level {
  color: #dc2626;
}

.detail-title {
  display: block;
  color: #0f172a;
  font-size: 22px;
  font-weight: 850;
  line-height: 1.3;
  margin-bottom: 10px;
}

.detail-summary {
  display: block;
  color: #475569;
  font-size: 14px;
  line-height: 1.65;
}

.meta-bar {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin-top: 14px;
  color: #94a3b8;
  font-size: 12px;
}

.content-body {
  margin: 0 14px 14px;
  padding: 18px;
  background: #fff;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(15,23,42,.05);
}

.content-body .article-h3 {
  margin: 18px 0 10px;
  color: #0f172a;
  font-size: 17px;
  font-weight: 800;
}

.content-body .article-p {
  margin: 9px 0;
  color: #334155;
  font-size: 15px;
  line-height: 1.85;
}

.content-body .article-ul {
  margin: 8px 0 14px;
  padding-left: 18px;
}

.content-body .article-li {
  margin: 8px 0;
  color: #334155;
  font-size: 15px;
  line-height: 1.75;
}

.source-footer {
  margin: 0 14px 32px;
  padding: 13px 14px;
  border-radius: 8px;
  background: #fff7ed;
  color: #9a3412;
  font-size: 12px;
  line-height: 1.6;
}

.empty-view {
  padding: 60px 0;
  text-align: center;
}

.empty-text {
  color: #94a3b8;
  font-size: 14px;
}
